{
  "name": "sumimi-studio-homepage",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public/"
  },
  "routes": [
    {
      "pattern": "sumimi.jp",
      "custom_domain": true
    },
    {
      "pattern": "www.sumimi.jp",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
